# ─── Application ───────────────────────────────────────────
APP_NAME=MeetMind
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEBUG=true

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://meetmind:meetmind@localhost:5432/meetmind
REDIS_URL=redis://localhost:6379/0

# ─── AI / LLM ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
HF_TOKEN=hf_...                        # HuggingFace for pyannote diarization

# ─── Vector Database ───────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                        # Leave empty for local Qdrant

# ─── Knowledge Graph ───────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=meetmind123

# ─── Object Storage ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=meetmind-uploads
# OR use local storage for development:
LOCAL_STORAGE_PATH=./uploads

# ─── LangSmith (optional but recommended) ──────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=meetmind

# ─── Integrations (add only what you need) ─────────────────

# Jira
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MEET

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_REPO=org/repo

# Linear
LINEAR_API_KEY=lin_api_...

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0XXXXXX

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Notion
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=

# Asana
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_GID=

# ─── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Auth ──────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
